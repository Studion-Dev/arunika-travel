---
import { siteConfig } from '../../config/site';

interface Props {
  activeNav?: string;
}

const { activeNav } = Astro.props;
const whatsappUrl = `https://wa.me/${siteConfig.contact.whatsapp}`;
---

<header
  id="main-navbar"
  class="fixed top-0 z-50 w-full border-b border-transparent bg-transparent py-5 transition-all duration-300 sm:py-6"
>
  <div
    id="navbar-container"
    class="mx-auto flex max-w-7xl items-center justify-between px-4 transition-all duration-300 sm:px-6 lg:px-8"
  >
    <!-- 1. KIRI: BRAND -->
    <a
      href="/"
      class="font-heading text-secondary flex items-center gap-2.5 text-xl font-bold tracking-tight"
      aria-label={`${siteConfig.name} - Beranda`}
    >
      <span
        class="bg-primary flex size-9 items-center justify-center rounded-xl font-bold text-white shadow-sm"
        aria-hidden="true"
      >
        {siteConfig.name.charAt(0)}
      </span>
      <span class="tracking-wide">{siteConfig.name}</span>
    </a>

    <!-- 2. TENGAH: LINK NAVIGASI DESKTOP -->
    <nav aria-label="Navigasi utama" class="hidden items-center gap-8 md:flex">
      {
        siteConfig.navigation.map((item) => (
          <a
            href={item.href}
            aria-current={activeNav === item.href ? 'page' : undefined}
            class:list={[
              'hover:text-primary relative py-1 text-sm font-medium transition-colors',
              activeNav === item.href
                ? 'text-primary font-semibold'
                : 'hover:text-primary text-slate-700',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- 3. KANAN: CTA BUTTON DESKTOP -->
    <div class="hidden md:flex">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-primary hover:bg-primary-hover focus-visible:outline-primary inline-flex items-center justify-center rounded-xl px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-all hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2"
      >
        Hubungi Kami
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      type="button"
      class="hover:text-secondary focus-visible:outline-primary inline-flex items-center justify-center rounded-lg p-2 text-slate-700 hover:bg-slate-100/80 focus-visible:outline-2 focus-visible:outline-offset-2 md:hidden"
      aria-label="Buka menu navigasi"
      aria-expanded="false"
      aria-controls="mobile-navigation"
      data-menu-toggle
    >
      <svg
        data-menu-open-icon
        class="size-6"
        aria-hidden="true"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
      </svg>

      <svg
        data-menu-close-icon
        class="hidden size-6"
        aria-hidden="true"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile Navigation -->
  <nav
    id="mobile-navigation"
    aria-label="Navigasi mobile"
    class="border-border bg-surface/95 hidden border-t px-4 pt-3 pb-6 shadow-lg backdrop-blur-md md:hidden"
    data-mobile-menu
    inert
  >
    <div class="flex flex-col gap-3">
      {
        siteConfig.navigation.map((item) => (
          <a
            href={item.href}
            aria-current={activeNav === item.href ? 'page' : undefined}
            class:list={[
              'hover:text-primary rounded-lg px-3 py-2 text-base font-medium transition-colors hover:bg-slate-100/80',
              activeNav === item.href
                ? 'text-primary bg-slate-100/50 font-semibold'
                : 'text-slate-700',
            ]}
            data-menu-link
          >
            {item.label}
          </a>
        ))
      }

      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-primary hover:bg-primary-hover mt-2 flex w-full items-center justify-center rounded-xl px-4 py-2.5 text-center text-sm font-semibold text-white shadow-sm"
      >
        Hubungi Kami
      </a>
    </div>
  </nav>
</header>

<script>
  function initNavbarLogic() {
    const header = document.getElementById('main-navbar');
    if (!header) return;

    // Handle Scroll threshold (1/2 viewport height = 0.5 * window.innerHeight)
    const handleScroll = () => {
      const scrollThreshold = window.innerHeight * 0.1;

      if (window.scrollY >= scrollThreshold) {
        // Scrolled past 1/2 viewport: beri background, border, shadow, dan perkecil padding
        header.classList.remove(
          'bg-transparent',
          'border-transparent',
          'py-5',
          'sm:py-6'
        );
        header.classList.add(
          'bg-surface/85',
          'backdrop-blur-md',
          'border-border',
          'shadow-xs',
          'py-2.5',
          'sm:py-3'
        );
      } else {
        // Kembali ke atas: polos transparan dan padding normal
        header.classList.remove(
          'bg-surface/85',
          'backdrop-blur-md',
          'border-border',
          'shadow-xs',
          'py-2.5',
          'sm:py-3'
        );
        header.classList.add(
          'bg-transparent',
          'border-transparent',
          'py-5',
          'sm:py-6'
        );
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll(); // Check initial state

    // Mobile menu toggle
    const toggle =
      header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const menu = header.querySelector<HTMLElement>('[data-mobile-menu]');
    const openIcon = header.querySelector<HTMLElement>('[data-menu-open-icon]');
    const closeIcon = header.querySelector<HTMLElement>(
      '[data-menu-close-icon]'
    );

    if (toggle && menu && toggle.dataset.initialized !== 'true') {
      toggle.dataset.initialized = 'true';

      const setMenuOpen = (isOpen: boolean) => {
        toggle.setAttribute('aria-expanded', String(isOpen));
        toggle.setAttribute(
          'aria-label',
          isOpen ? 'Tutup menu navigasi' : 'Buka menu navigasi'
        );

        menu.classList.toggle('hidden', !isOpen);
        menu.inert = !isOpen;

        openIcon?.classList.toggle('hidden', isOpen);
        closeIcon?.classList.toggle('hidden', !isOpen);
      };

      toggle.addEventListener('click', () => {
        const isOpen = toggle.getAttribute('aria-expanded') === 'true';
        setMenuOpen(!isOpen);
      });

      menu
        .querySelectorAll<HTMLAnchorElement>('[data-menu-link]')
        .forEach((link) => {
          link.addEventListener('click', () => setMenuOpen(false));
        });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setMenuOpen(false);
      });

      setMenuOpen(false);
    }
  }

  initNavbarLogic();
  document.addEventListener('astro:page-load', initNavbarLogic);
</script>
