---
import { homeContent } from '../../config/content';
import {
  Sparkles,
  Car,
  UserCheck,
  ShieldCheck,
  Compass,
  Star,
  CheckCircle2,
} from '@lucide/astro';

const { valueProp } = homeContent;

// Pemetaan icon Lucide berdasarkan item key
const iconMap = [Car, UserCheck, ShieldCheck, Compass];
---

<section class="overflow-hidden bg-white py-20 lg:py-28" data-reveal="up">
  <div class="w-full px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-12 lg:gap-16">
      <!-- =========================================
          SISI KIRI: HEADLINE & AVATAR STACK (TRUST)
         ========================================= -->
      <div
        class="flex h-full flex-col justify-between space-y-8 lg:sticky lg:top-28 lg:col-span-5"
      >
        <!-- Header Info -->
        <div class="space-y-4">
          <span
            class="bg-primary/10 text-primary font-heading inline-flex items-center gap-1.5 rounded-full px-3.5 py-1.5 text-xs font-semibold tracking-wider uppercase"
          >
            <Sparkles class="text-primary size-3.5" />
            {valueProp.eyebrow}
          </span>

          <h2
            class="text-secondary font-heading text-3xl leading-tight font-bold tracking-tight sm:text-4xl lg:text-5xl"
          >
            {valueProp.title}
          </h2>

          <p class="pt-2 text-base leading-relaxed text-slate-600 sm:text-lg">
            {valueProp.description}
          </p>
        </div>

        <!-- Social Proof / Avatar Stack Nunjukkan Trust -->
        <div
          class="border-border flex flex-col items-start gap-4 border-t pt-4 sm:flex-row sm:items-center"
        >
          <!-- Stack Photo Avatars -->
          <div class="flex items-center -space-x-3 overflow-hidden">
            <img
              class="inline-block size-11 rounded-full object-cover ring-2 ring-white"
              src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=200&auto=format&fit=crop"
              alt="Wisatawan Arunika"
            />
            <img
              class="inline-block size-11 rounded-full object-cover ring-2 ring-white"
              src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=200&auto=format&fit=crop"
              alt="Wisatawan Arunika"
            />
            <img
              class="inline-block size-11 rounded-full object-cover ring-2 ring-white"
              src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?q=80&w=200&auto=format&fit=crop"
              alt="Wisatawan Arunika"
            />
            <img
              class="inline-block size-11 rounded-full object-cover ring-2 ring-white"
              src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?q=80&w=200&auto=format&fit=crop"
              alt="Wisatawan Arunika"
            />
            <div
              class="bg-primary font-heading flex size-11 items-center justify-center rounded-full text-xs font-bold text-white ring-2 ring-white"
            >
              +5k
            </div>
          </div>

          <!-- Trust Label & Rating -->
          <div class="space-y-1">
            <div class="flex items-center gap-1 text-amber-500">
              <Star class="size-4 fill-amber-400" />
              <Star class="size-4 fill-amber-400" />
              <Star class="size-4 fill-amber-400" />
              <Star class="size-4 fill-amber-400" />
              <Star class="size-4 fill-amber-400" />
              <span class="text-secondary font-heading ml-1 text-xs font-bold"
                >5.0 / 5.0</span
              >
            </div>
            <p class="text-xs font-medium text-slate-600">
              Dipercaya <strong>5.000+ wisatawan</strong> dari seluruh Indonesia
            </p>
          </div>
        </div>
      </div>

      <!-- =========================================
          SISI KANAN: BENTO GRID VALUE PROPOSITION
         ========================================= -->
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:col-span-7">
        {/* Bento 1: Armada Terbaru (Span 2 Kolom - Highlight Utama) */}
        {
          valueProp.items[0] && (
            <div class="group relative flex flex-col justify-between overflow-hidden rounded-3xl bg-gradient-to-br from-slate-900 to-slate-800 p-7 text-white shadow-xl sm:col-span-2 sm:p-8">
              <div class="bg-primary/20 pointer-events-none absolute -right-10 -bottom-10 size-48 rounded-full blur-3xl" />

              <div class="relative z-10 flex items-start justify-between gap-4">
                <div class="flex size-12 items-center justify-center rounded-2xl border border-white/15 bg-white/10 text-amber-400 backdrop-blur-md">
                  <Car class="size-6" />
                </div>
                <span class="bg-primary/30 border-primary/40 font-heading rounded-full border px-3 py-1 text-xs font-semibold text-blue-200">
                  Prioritas Utama
                </span>
              </div>

              <div class="relative z-10 mt-8 space-y-3">
                <h3 class="font-heading text-2xl font-bold text-white">
                  {valueProp.items[0].title}
                </h3>
                <p class="text-sm leading-relaxed text-slate-300 sm:text-base">
                  {valueProp.items[0].description}
                </p>
              </div>

              <div class="relative z-10 mt-6 flex flex-wrap gap-4 border-t border-white/10 pt-4 text-xs font-medium text-slate-300">
                <span class="flex items-center gap-1.5">
                  <CheckCircle2 class="size-3.5 text-amber-400" /> AC Dingin &
                  Bersih
                </span>
                <span class="flex items-center gap-1.5">
                  <CheckCircle2 class="size-3.5 text-amber-400" /> Service
                  Berkala
                </span>
                <span class="flex items-center gap-1.5">
                  <CheckCircle2 class="size-3.5 text-amber-400" /> Unit HiAce &
                  Avanza
                </span>
              </div>
            </div>
          )
        }

        {/* Bento 2: Driver & Guide Lokal Ramah */}
        {
          valueProp.items[1] && (
            <div class="bg-surface border-border flex flex-col justify-between rounded-3xl border p-6 shadow-xs transition-shadow hover:shadow-md sm:p-7">
              <div class="space-y-4">
                <div class="bg-primary/10 text-primary flex size-11 items-center justify-center rounded-2xl">
                  <UserCheck class="size-5" />
                </div>
                <h3 class="font-heading text-secondary text-xl font-bold">
                  {valueProp.items[1].title}
                </h3>
                <p class="text-sm leading-relaxed text-slate-600">
                  {valueProp.items[1].description}
                </p>
              </div>
            </div>
          )
        }

        {/* Bento 3: Harga Transparan & Tanpa Hidden Cost */}
        {
          valueProp.items[2] && (
            <div class="bg-surface border-border flex flex-col justify-between rounded-3xl border p-6 shadow-xs transition-shadow hover:shadow-md sm:p-7">
              <div class="space-y-4">
                <div class="flex size-11 items-center justify-center rounded-2xl bg-amber-500/10 text-amber-600">
                  <ShieldCheck class="size-5" />
                </div>
                <h3 class="font-heading text-secondary text-xl font-bold">
                  {valueProp.items[2].title}
                </h3>
                <p class="text-sm leading-relaxed text-slate-600">
                  {valueProp.items[2].description}
                </p>
              </div>
            </div>
          )
        }

        {/* Bento 4: Itinerary Fleksibel (Span 2 Kolom) */}
        {
          valueProp.items[3] && (
            <div class="flex flex-col items-start justify-between gap-6 rounded-3xl border border-slate-200 bg-slate-50 p-6 shadow-xs transition-shadow hover:shadow-md sm:col-span-2 sm:flex-row sm:items-center sm:p-7">
              <div class="max-w-md space-y-2">
                <div class="flex items-center gap-2">
                  <div class="flex size-9 shrink-0 items-center justify-center rounded-xl bg-emerald-500/10 text-emerald-600">
                    <Compass class="size-4" />
                  </div>
                  <h3 class="font-heading text-secondary text-lg font-bold">
                    {valueProp.items[3].title}
                  </h3>
                </div>
                <p class="text-xs leading-relaxed text-slate-600 sm:text-sm">
                  {valueProp.items[3].description}
                </p>
              </div>

              <a
                href="/kontak"
                class="text-secondary border-border shrink-0 rounded-xl border bg-white px-4 py-2.5 text-xs font-semibold shadow-xs transition-colors hover:bg-slate-100"
              >
                Diskusi Itinerary
              </a>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
