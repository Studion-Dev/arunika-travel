---
import { siteConfig } from '../../config/site';
import { contactContent } from '../../config/content';
import {
  Sparkles,
  MapPin,
  Phone,
  Mail,
  Clock,
  ExternalLink,
  MessageCircle,
} from '@lucide/astro';

const { contactSection } = contactContent;

// Link Google Maps langsung ke alamat kantor
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(siteConfig.contact.address)}`;
---

<section class="bg-surface overflow-hidden py-16 lg:py-24" data-reveal="up">
  <div class="w-full px-4 sm:px-6 lg:px-8">
    <div
      class="mx-auto grid grid-cols-1 items-start gap-12 lg:grid-cols-12 lg:gap-16"
    >
      <!-- =========================================
          SISI KIRI: BADGE, HEADLINE & INFORMASI ALAMAT
         ========================================= -->
      <div class="space-y-8 lg:col-span-5" data-reveal="right">
        <!-- Badge & Headline -->
        <div class="space-y-3">
          <span
            class="bg-primary/10 text-primary font-heading inline-flex items-center gap-1.5 rounded-full px-3.5 py-1.5 text-xs font-semibold tracking-wider uppercase"
          >
            <Sparkles class="size-3.5" />
            Layanan Pelanggan
          </span>
          <h2
            class="text-secondary font-heading text-3xl leading-tight font-bold tracking-tight sm:text-4xl lg:text-5xl"
          >
            {contactSection.title}
          </h2>
          <p class="pt-1 text-base leading-relaxed text-slate-600">
            {contactSection.subtitle}
          </p>
        </div>

        <!-- Box Informasi Alamat Utama & Jam Operasional -->
        <div
          class="border-border space-y-6 rounded-3xl border bg-white p-6 shadow-xs sm:p-7"
        >
          <!-- Alamat -->
          <div class="flex items-start gap-4">
            <div
              class="bg-primary/10 text-primary mt-1 flex size-10 shrink-0 items-center justify-center rounded-2xl"
            >
              <MapPin class="size-5" />
            </div>
            <div class="space-y-1">
              <h3 class="font-heading text-secondary text-base font-bold">
                Alamat Garasi & Kantor
              </h3>
              <p class="text-sm leading-relaxed text-slate-600">
                {siteConfig.contact.address}
              </p>
            </div>
          </div>

          <div class="border-border border-t pt-6">
            <!-- Jam Operasional -->
            <div class="flex items-start gap-4">
              <div
                class="mt-1 flex size-10 shrink-0 items-center justify-center rounded-2xl bg-amber-500/10 text-amber-600"
              >
                <Clock class="size-5" />
              </div>
              <div class="space-y-1">
                <h3 class="font-heading text-secondary text-base font-bold">
                  Jam Operasional
                </h3>
                <p class="text-sm text-slate-600">
                  {siteConfig.contact.hours}
                </p>
                <p class="pt-0.5 text-xs font-semibold text-emerald-600">
                  &bull; Layanan WhatsApp CS Buka 24 Jam
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- =========================================
          SISI KANAN: LIST KONTAK MEDSOS & STATIC MAPS
         ========================================= -->
      <div class="space-y-8 lg:col-span-7" data-reveal="left">
        <!-- List Wrapper Per Kontak & Medsos -->
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <!-- WhatsApp Wrapper -->
          <a
            href={`https://wa.me/${siteConfig.contact.whatsapp}?text=Halo%20Arunika%20Travel,%20saya%20mau%20tanya%20paket`}
            target="_blank"
            rel="noopener noreferrer"
            class="border-border group flex items-center justify-between gap-4 rounded-2xl border bg-white p-5 transition-all hover:border-emerald-500 hover:shadow-md"
          >
            <div class="flex min-w-0 items-center gap-3.5">
              <div
                class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-emerald-500/10 text-emerald-600 transition-colors group-hover:bg-emerald-600 group-hover:text-white"
              >
                <MessageCircle class="size-5" />
              </div>
              <div class="min-w-0">
                <p class="text-xs font-medium text-slate-500">WhatsApp CS</p>
                <p
                  class="font-heading text-secondary truncate text-sm font-bold"
                >
                  +{siteConfig.contact.whatsapp}
                </p>
              </div>
            </div>
            <ExternalLink
              class="size-4 shrink-0 text-slate-400 transition-colors group-hover:text-emerald-600"
            />
          </a>

          <!-- Telepon Wrapper -->
          <a
            href={`tel:+${siteConfig.contact.phone}`}
            class="border-border hover:border-primary group flex items-center justify-between gap-4 rounded-2xl border bg-white p-5 transition-all hover:shadow-md"
          >
            <div class="flex min-w-0 items-center gap-3.5">
              <div
                class="bg-primary/10 text-primary group-hover:bg-primary flex size-11 shrink-0 items-center justify-center rounded-xl transition-colors group-hover:text-white"
              >
                <Phone class="size-5" />
              </div>
              <div class="min-w-0">
                <p class="text-xs font-medium text-slate-500">
                  Telepon Langsung
                </p>
                <p
                  class="font-heading text-secondary truncate text-sm font-bold"
                >
                  +{siteConfig.contact.phone}
                </p>
              </div>
            </div>
            <ExternalLink
              class="group-hover:text-primary size-4 shrink-0 text-slate-400 transition-colors"
            />
          </a>

          <!-- Email Wrapper -->
          <a
            href={`mailto:${siteConfig.contact.email}`}
            class="border-border hover:border-primary group flex items-center justify-between gap-4 rounded-2xl border bg-white p-5 transition-all hover:shadow-md"
          >
            <div class="flex min-w-0 items-center gap-3.5">
              <div
                class="bg-primary/10 text-primary group-hover:bg-primary flex size-11 shrink-0 items-center justify-center rounded-xl transition-colors group-hover:text-white"
              >
                <Mail class="size-5" />
              </div>
              <div class="min-w-0">
                <p class="text-xs font-medium text-slate-500">
                  Email Informasi
                </p>
                <p
                  class="font-heading text-secondary truncate text-sm font-bold"
                >
                  {siteConfig.contact.email}
                </p>
              </div>
            </div>
            <ExternalLink
              class="group-hover:text-primary size-4 shrink-0 text-slate-400 transition-colors"
            />
          </a>

          <!-- Instagram Wrapper (Menggunakan SVG Resmi karena tidak ada di Lucide) -->
          <a
            href={siteConfig.social.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="border-border group flex items-center justify-between gap-4 rounded-2xl border bg-white p-5 transition-all hover:border-pink-500 hover:shadow-md"
          >
            <div class="flex min-w-0 items-center gap-3.5">
              <div
                class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-pink-500/10 text-pink-600 transition-colors group-hover:bg-pink-600 group-hover:text-white"
              >
                <!-- Custom SVG Instagram -->
                <svg
                  class="size-5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                >
                  <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
                  ></path>
                  <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
                </svg>
              </div>
              <div class="min-w-0">
                <p class="text-xs font-medium text-slate-500">
                  Instagram Resmi
                </p>
                <p
                  class="font-heading text-secondary truncate text-sm font-bold"
                >
                  @arunikatravel.id
                </p>
              </div>
            </div>
            <ExternalLink
              class="size-4 shrink-0 text-slate-400 transition-colors group-hover:text-pink-600"
            />
          </a>
        </div>

        <!-- Static Image Map (Ringan, Tanpa Iframe, Klik Langsung ke Google Maps) -->
        <div class="space-y-2">
          <a
            href={mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Buka lokasi Arunika Travel di Google Maps"
            class="border-border group relative block h-64 w-full overflow-hidden rounded-3xl border bg-slate-900 shadow-md sm:h-72"
          >
            <img
              src="https://images.unsplash.com/photo-1526778548025-fa2f459cd5c1?q=80&w=1200&auto=format&fit=crop"
              alt="Peta Lokasi Kantor Arunika Travel Yogyakarta"
              class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
            />
            <div
              class="absolute inset-0 flex flex-col items-center justify-center bg-slate-950/40 p-4 transition-colors group-hover:bg-slate-950/30"
            >
              <div
                class="bg-primary flex size-14 items-center justify-center rounded-full text-white shadow-2xl transition-transform group-hover:scale-110"
              >
                <MapPin class="size-7" />
              </div>
              <span
                class="text-secondary font-heading mt-3 inline-flex items-center gap-1.5 rounded-full bg-white/95 px-4 py-2 text-xs font-bold shadow-lg backdrop-blur-xs"
              >
                <span>Klik untuk Petunjuk Arah di Google Maps</span>
                <ExternalLink class="text-primary size-3.5" />
              </span>
            </div>
          </a>
          <p class="text-center text-xs text-slate-500">
            *Lokasi garasi dekat dengan Stasiun Lempuyangan & Tugu Jogja
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
