---
import { homeContent } from '../../config/content';
import { ArrowRight, Clock, CheckCircle2, Sparkles } from '@lucide/astro';
import { Image } from 'astro:assets';

// Import gambar lokal untuk 3 paket terlaris menggunakan Astro Assets
import merapiImg from '../../assets/images/merapi-jeep.webp';
import pantaiImg from '../../assets/images/gunungkidul-beach.webp';
import kulinerImg from '../../assets/images/kuliner.webp';

const { featuredPackages } = homeContent;

// Pemetaan aset gambar lokal berdasarkan urutan / ID paket
const featuredImages = [merapiImg, pantaiImg, kulinerImg];
---

<section class="bg-surface overflow-hidden py-20 lg:py-28" data-reveal="up">
  <div class="w-full px-4 sm:px-6 lg:px-8">
    <div
      class="mb-12 grid grid-cols-1 items-end gap-6 lg:mb-16 lg:grid-cols-12 lg:gap-12"
    >
      <div class="space-y-3 lg:col-span-7">
        <span
          class="bg-primary/10 text-primary font-heading inline-flex items-center gap-1.5 rounded-full px-3.5 py-1.5 text-xs font-semibold tracking-wider uppercase"
        >
          <Sparkles class="size-3.5" />
          {featuredPackages.eyebrow}
        </span>
        <h2
          class="text-secondary font-heading text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl"
        >
          {featuredPackages.title}
        </h2>
      </div>

      <div class="lg:col-span-5">
        <p class="text-base leading-relaxed text-slate-600 sm:text-lg">
          {featuredPackages.description}
        </p>
      </div>
    </div>

    <!-- Grid Paket (3 Items) -->
    <div class="grid grid-cols-1 items-stretch gap-8 lg:grid-cols-3">
      {
        /* =========================================
          CARD 1: MODEL CARD IMAGE (Latar Belakang Gambar)
         ========================================= */
      }
      {
        featuredPackages.items[0] && (
          <div class="group relative flex min-h-[500px] flex-col justify-end overflow-hidden rounded-3xl bg-slate-900 p-6 shadow-2xl transition-transform duration-500 hover:-translate-y-1 sm:min-h-[540px] sm:p-8">
            <Image
              src={featuredImages[0]}
              alt={featuredPackages.items[0].title}
              class="absolute inset-0 h-full w-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105"
              quality={80}
              format="webp"
              loading="lazy"
            />

            {/* Multi-layer Gradient Overlay untuk Kontras Teks Maksimal */}
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/60 to-slate-950/20" />

            {/* Badge di pojok kiri atas */}
            <div class="absolute top-6 left-6 z-10">
              <span class="bg-accent text-secondary font-heading inline-flex items-center gap-1.5 rounded-full px-4 py-1.5 text-xs font-bold tracking-wider uppercase shadow-md">
                <Sparkles class="size-3.5" />
                {featuredPackages.items[0].badge}
              </span>
            </div>

            {/* Content di bagian bawah card */}
            <div class="relative z-10 space-y-5 text-white">
              {/* Durasi & Harga */}
              <div class="flex items-center justify-between gap-4 rounded-2xl border border-white/15 bg-white/10 px-4 py-2.5 backdrop-blur-md">
                <span class="inline-flex items-center gap-1.5 text-xs font-medium text-amber-300 sm:text-sm">
                  <Clock class="size-4" />
                  {featuredPackages.items[0].duration}
                </span>
                <span class="font-heading text-lg font-bold text-white sm:text-xl">
                  {featuredPackages.items[0].price}{' '}
                  <span class="text-xs font-normal text-slate-300">/ pax</span>
                </span>
              </div>

              {/* Judul Paket */}
              <h3 class="font-heading text-2xl leading-tight font-bold tracking-tight text-white drop-shadow-sm sm:text-3xl">
                {featuredPackages.items[0].title}
              </h3>

              {/* Highlights Fasilitas */}
              <ul class="space-y-2.5 border-t border-white/20 pt-1 text-sm text-slate-200">
                {featuredPackages.items[0].inclusions?.map((item) => (
                  <li class="flex items-center gap-2.5">
                    <CheckCircle2 class="text-accent size-4 shrink-0" />
                    <span class="font-medium">{item}</span>
                  </li>
                ))}
              </ul>

              {/* Action Button */}
              <div class="pt-2">
                <a
                  href={`https://wa.me/6281234567890?text=Halo%20Arunika%20Travel,%20saya%20tertarik%20dengan%20${encodeURIComponent(featuredPackages.items[0].title)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="bg-accent text-secondary inline-flex w-full items-center justify-center gap-2 rounded-2xl px-5 py-3.5 text-center text-sm font-bold shadow-lg transition-all hover:bg-amber-400 hover:shadow-xl sm:text-base"
                >
                  Pesan Paket Ini
                  <ArrowRight class="size-4" />
                </a>
              </div>
            </div>
          </div>
        )
      }

      {
        /* =========================================
          CARD 2 & 3: MODEL CARD BIASA DENGAN THUMBNAIL
         ========================================= */
      }
      {
        featuredPackages.items.slice(1, 3).map((pkg, index) => {
          // Index 1 menggunakan gambar pantai (index 1 di array featuredImages), dst.
          const currentImage = featuredImages[index + 1] || pantaiImg;
          return (
            <div class="border-border flex flex-col justify-between overflow-hidden rounded-3xl border bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
              {/* Thumbnail Image dengan Astro Assets & Lazy Loading */}
              <div class="group relative h-56 overflow-hidden bg-slate-100 sm:h-64">
                <Image
                  src={currentImage}
                  alt={pkg.title}
                  class="h-full w-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105"
                  quality={80}
                  format="webp"
                  loading="lazy"
                />
                <div class="absolute top-4 left-4 z-10">
                  <span class="text-secondary font-heading rounded-full bg-white/90 px-3.5 py-1.5 text-xs font-semibold tracking-wider uppercase shadow-sm backdrop-blur-md">
                    {pkg.badge}
                  </span>
                </div>
              </div>

              {/* Content Card */}
              <div class="flex flex-1 flex-col justify-between space-y-6 p-6 sm:p-8">
                <div class="space-y-4">
                  <div class="flex items-center justify-between text-xs font-medium text-slate-500 sm:text-sm">
                    <span class="text-primary inline-flex items-center gap-1">
                      <Clock class="size-4" />
                      {pkg.duration}
                    </span>
                    <span class="font-heading text-secondary text-lg font-bold sm:text-xl">
                      {pkg.price}{' '}
                      <span class="text-xs font-normal text-slate-500">
                        / pax
                      </span>
                    </span>
                  </div>

                  <h3 class="font-heading text-secondary text-xl leading-snug font-bold">
                    {pkg.title}
                  </h3>

                  <ul class="border-border space-y-2 border-t pt-2 text-sm text-slate-600">
                    {pkg.inclusions?.map((item) => (
                      <li class="flex items-center gap-2">
                        <CheckCircle2 class="text-primary size-4 shrink-0" />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="pt-4">
                  <a
                    href={`https://wa.me/6281234567890?text=Halo%20Arunika%20Travel,%20saya%20tertarik%20dengan%20${encodeURIComponent(pkg.title)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="bg-surface text-secondary border-border inline-flex w-full items-center justify-center gap-2 rounded-xl border px-4 py-3 text-center text-sm font-semibold transition-colors hover:bg-slate-100"
                  >
                    Pesan Paket Ini
                    <ArrowRight class="size-4" />
                  </a>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>

    {/* CTA Bawah Menuju Halaman Paket Lengkap */}
    <div class="mt-14 text-center" data-reveal="up">
      <a
        href="/paket"
        class="bg-primary hover:bg-primary-hover inline-flex items-center gap-2 rounded-2xl px-8 py-4 text-base font-semibold text-white shadow-md transition-all hover:shadow-lg"
      >
        <span>Lihat Semua Daftar Paket Wisata Lengkap</span>
        <ArrowRight class="size-5" />
      </a>
    </div>
  </div>
</section>
