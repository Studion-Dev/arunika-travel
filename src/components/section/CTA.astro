---
import { homeContent } from '../../config/content';
import { Sparkles } from '@lucide/astro';

const { cta } = homeContent;
---

<section class="overflow-hidden bg-white py-20 lg:py-28" data-reveal="up">
  <div class="w-full space-y-10 px-4 sm:px-6 lg:px-8">
    <!-- Bagian Atas: Kiri (Badge & Headline) | Kanan (Deskripsi) -->
    <div
      class="mx-auto grid grid-cols-1 items-end gap-6 lg:grid-cols-12 lg:gap-12"
    >
      <div class="space-y-3 lg:col-span-7">
        <span
          class="bg-primary/10 text-primary font-heading inline-flex items-center gap-1.5 rounded-full px-3.5 py-1.5 text-xs font-semibold tracking-wider uppercase"
        >
          <Sparkles class="size-3.5" />
          {cta.eyebrow}
        </span>
        <h2
          class="text-secondary font-heading text-3xl leading-tight font-bold tracking-tight sm:text-4xl lg:text-5xl"
        >
          {cta.title}
        </h2>
      </div>

      <div class="lg:col-span-5">
        <p class="text-base leading-relaxed text-slate-600 sm:text-lg">
          {cta.description}
        </p>
      </div>
    </div>

    <!-- Bagian Bawah: Wrapper Image Full Width dengan Tinggi Proporsional & Tombol CTA -->
    <div class="w-full" data-reveal="up">
      <div
        class="group relative flex h-[40vh] w-full items-center justify-center overflow-hidden rounded-3xl bg-slate-900 p-6 shadow-2xl sm:h-[48vh] sm:p-12 lg:h-[54vh]"
      >
        <!-- Background Image -->
        <img
          src="https://images.unsplash.com/photo-1584646098378-0874589d76b1?q=80&w=1600&auto=format&fit=crop"
          alt="Pemandangan Yogyakarta Arunika Travel"
          class="absolute inset-0 h-full w-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105"
        />

        <!-- Gradient Overlay Gelap Biar Teks & Tombol Kontras -->
        <div class="absolute inset-0 bg-slate-950/60 backdrop-blur-[2px]"></div>

        <!-- Content di Tengah Gambar -->
        <div class="relative z-10 mx-auto max-w-2xl space-y-6 text-center">
          <h3
            class="font-heading text-2xl leading-snug font-bold tracking-tight text-white sm:text-3xl lg:text-4xl"
          >
            Wujudkan Liburan Impianmu di Jogja Bersama Kami Sekarang
          </h3>

          <div>
            <a
              href={cta.buttonHref}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-accent text-secondary inline-flex items-center justify-center gap-2.5 rounded-2xl px-8 py-4 text-base font-bold shadow-xl transition-all hover:scale-105 hover:bg-amber-400"
            >
              <!-- Custom WhatsApp SVG -->
              <svg
                class="text-secondary size-5"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-2.972-1.481-4.925-2.652-6.892-6.075-.149-.248-.016-.383.11-.511.112-.112.248-.297.371-.446.124-.149.165-.248.248-.415.083-.166.042-.314-.021-.443-.063-.129-.57-1.375-.782-1.883-.206-.498-.416-.43-.57-.438-.149-.008-.32-.008-.491-.008-.171 0-.448.062-.683.314-.235.252-.899.878-.899 2.142 0 1.264.921 2.482 1.048 2.653.128.172 1.812 2.766 4.391 3.878 2.579 1.112 2.579.741 3.05.692.47-.049 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
                ></path>
              </svg>
              {cta.buttonLabel}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
