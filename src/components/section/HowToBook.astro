---
import { packagesContent } from '../../config/content';
import { siteConfig } from '../../config/site';
import {
  MessageSquare,
  ShieldCheck,
  Zap,
  Headphones,
  ArrowRight,
  Clock,
} from '@lucide/astro';

const { howToBook } = packagesContent;
---

<section class="overflow-hidden bg-white py-20 lg:py-28" data-reveal="up">
  <div class="w-full space-y-12 px-4 sm:px-6 lg:space-y-16 lg:px-8">
    <!-- 1. HEADER SECTION (Headline 1 Baris Centered & Value Bar Horizontal) -->
    <div class="mx-auto space-y-8 text-center">
      <!-- Headline 1 Baris Centered -->
      <h2
        class="text-secondary font-heading overflow-hidden pb-1 text-2xl font-bold tracking-tight text-ellipsis whitespace-nowrap sm:text-4xl lg:text-5xl"
      >
        {howToBook.title}
      </h2>

      <!-- Value Bar Berjejer Horizontal Justify-Between -->
      <div
        class="border-border font-heading flex flex-wrap items-center justify-between gap-4 border-t pt-6 text-xs font-semibold text-slate-700 sm:text-sm"
      >
        <div class="flex items-center gap-2">
          <Zap class="text-accent size-4" />
          <span>Respon WA Cepat (5 Menit)</span>
        </div>
        <div class="flex items-center gap-2">
          <ShieldCheck class="text-primary size-4" />
          <span>DP Aman & Terverifikasi</span>
        </div>
        <div class="flex items-center gap-2">
          <Clock class="size-4 text-emerald-600" />
          <span>Itinerary Fleksibel</span>
        </div>
        <div class="flex items-center gap-2">
          <Headphones class="text-primary size-4" />
          <span>Pendampingan 24/7</span>
        </div>
      </div>
    </div>

    <!-- 2. KONTEN UTAMA (Kiri: Image + Floating Info Card | Kanan: Step-by-Step Wrapper) -->
    <div
      class="mx-auto grid grid-cols-1 items-stretch gap-8 lg:grid-cols-12 lg:gap-12"
    >
      <!-- KONTEN KIRI: Image Wrapper + Floating Card Ber-BG Blur + Mini Action Button -->
      <div
        class="group relative flex min-h-[420px] flex-col justify-end overflow-hidden rounded-3xl bg-slate-900 p-6 shadow-xl sm:p-8 lg:col-span-5 lg:min-h-full"
        data-reveal="right"
      >
        <!-- Background Image -->
        <img
          src="https://images.unsplash.com/photo-1512100356356-de1b84283e18?q=80&w=1200&auto=format&fit=crop"
          alt="Layanan Perjalanan Arunika Travel"
          class="absolute inset-0 h-full w-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105"
        />
        <!-- Overlay Gradient -->
        <div
          class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-950/20 to-transparent"
        >
        </div>

        <!-- Floating Info Box di Bagian Bawah Gambar (Glassmorphism Blur) -->
        <div
          class="relative z-10 space-y-4 rounded-2xl border border-white/20 bg-white/15 p-5 text-white shadow-lg backdrop-blur-md"
        >
          <div class="flex items-center justify-between gap-2">
            <span
              class="text-secondary font-heading inline-flex items-center gap-1.5 rounded-full bg-amber-400 px-3 py-1 text-xs font-bold"
            >
              Bantuan Cepat
            </span>
            <span class="text-xs font-medium text-slate-200"
              >Buka Setiap Hari</span
            >
          </div>

          <div>
            <h4 class="font-heading text-base font-bold text-white">
              Bingung Pilih Paket yang Pas?
            </h4>
            <p class="mt-1 text-xs leading-relaxed text-slate-200">
              Tim admin kami siap membantu merangkai itinerary dan estimasi
              biaya sesuai budget Anda.
            </p>
          </div>

          <!-- Mini Action Button -->
          <a
            href={`https://wa.me/${siteConfig.contact.whatsapp}?text=Halo%20Arunika%20Travel,%20saya%20mau%20tanya%20prosedur%20booking`}
            target="_blank"
            rel="noopener noreferrer"
            class="text-secondary inline-flex w-full items-center justify-center gap-2 rounded-xl bg-white px-4 py-2.5 text-center text-xs font-bold shadow-xs transition-colors hover:bg-slate-100"
          >
            <MessageSquare class="size-3.5 text-emerald-600" />
            <span>Tanya Admin via WhatsApp</span>
          </a>
        </div>
      </div>

      <!-- KONTEN KANAN: Deskripsi & Wrapper Per Step Pemesanan -->
      <div
        class="flex flex-col justify-between space-y-6 lg:col-span-7"
        data-reveal="left"
      >
        <div>
          <p class="mb-6 text-base leading-relaxed text-slate-600 sm:text-lg">
            {howToBook.subtitle}
          </p>

          <!-- List Steps Dibungkus Wrapper Per Step -->
          <div class="space-y-4">
            {
              howToBook.steps.map((item) => (
                <div class="bg-surface border-border hover:border-primary/40 group flex items-start gap-4 rounded-2xl border p-5 transition-all hover:bg-white hover:shadow-md sm:p-6">
                  {/* Step Number Badge */}
                  <div class="bg-primary/10 text-primary font-heading group-hover:bg-primary flex size-10 shrink-0 items-center justify-center rounded-xl text-sm font-bold transition-colors group-hover:text-white">
                    {item.step}
                  </div>

                  {/* Step Detail */}
                  <div class="space-y-1">
                    <h3 class="font-heading text-secondary text-base font-bold sm:text-lg">
                      {item.title}
                    </h3>
                    <p class="text-xs leading-relaxed text-slate-600 sm:text-sm">
                      {item.description}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Optional Bottom Note / CTA -->
        <div class="pt-2">
          <a
            href={`https://wa.me/${siteConfig.contact.whatsapp}?text=Halo%20Arunika%20Travel,%20saya%20siap%20booking%20paket`}
            target="_blank"
            rel="noopener noreferrer"
            class="text-primary font-heading inline-flex items-center gap-2 text-sm font-bold hover:underline"
          >
            <span>Mulai Booking Sekarang</span>
            <ArrowRight class="size-4" />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
